{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singsync.local/sync_schema_v1.json",
  "title": "SingSync Sync Metadata v1",
  "type": "object",
  "required": [
    "schema_version",
    "video_id",
    "created_at",
    "updated_at",
    "markers",
    "alignment",
    "corrections"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "markers": {
      "type": "object",
      "required": ["vocal_onsets", "phrase_gaps"],
      "properties": {
        "vocal_onsets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/markerPoint"
          }
        },
        "phrase_gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/markerPoint"
          }
        },
        "source": {
          "type": "string"
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "alignment": {
      "type": "object",
      "required": ["line_timings"],
      "properties": {
        "line_timings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lineTiming"
          }
        }
      },
      "additionalProperties": false
    },
    "corrections": {
      "type": "object",
      "required": ["events", "aggregates"],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/correctionEvent"
          }
        },
        "aggregates": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/correctionAggregate"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "markerPoint": {
      "type": "object",
      "required": ["ms", "strength"],
      "properties": {
        "ms": {
          "type": "number",
          "minimum": 0
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "lineTiming": {
      "type": "object",
      "required": ["line_id", "start_ms", "end_ms", "confidence"],
      "properties": {
        "line_id": {
          "type": "string"
        },
        "start_ms": {
          "type": "number",
          "minimum": 0
        },
        "end_ms": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "correctionEvent": {
      "type": "object",
      "required": ["line_id", "new_start_ms", "created_at"],
      "properties": {
        "line_id": {
          "type": "string"
        },
        "new_start_ms": {
          "type": "number",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "correctionAggregate": {
      "type": "object",
      "required": ["median_offset_ms", "votes"],
      "properties": {
        "median_offset_ms": {
          "type": "number"
        },
        "votes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
